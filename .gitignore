# Dependencies
node_modules/

# Build output
dist/
dist-electron/
out/

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
!.vscode/extensions.json
.idea/

# Vite
vite.config.ts.timestamp-*

# Data dumps
data-dump/

# Meta build cache (intermediate API data, not the final output).
# Globbed, not an exact path: these caches get copied or renamed per worktree
# and per collection run (.cache.bak, .cache-spells-worktree-2026-06-30, ...),
# and every one of them holds harvested Riot PUUIDs. An exact-path rule only
# covers the name someone happened to use, so a rename silently drops player
# identifiers back into `git add -A` range.
data/meta-builds/.cache*/

# Staging files for in-progress meta build collection runs
src/data/meta-builds/*.new.json

# "Current status" files
**/STATUS.md
*.pdf
status.md
CONTINUE.md

# ow-package-guard run log (persisted per-launch for after-the-fact diagnosis)
.ow-guard.log

# Agent working directory. Holds side worktrees (`.claude/worktrees/<name>`),
# each a full checkout with its own node_modules, so this is hundreds of
# megabytes of things git already tracks elsewhere.
.claude/

# Generated codebase wiki. Regenerable from the source it describes, and it
# goes stale the moment the code moves.
wiki/
